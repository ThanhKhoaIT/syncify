# Production store — READ-ONLY custom app token.
# Create a custom app in the Production store admin and grant it ONLY
# read_products, read_online_store_pages, read_metafields, read_discounts
# scopes (no write_* scopes). This is the primary safety mechanism: even if
# syncify's logic ever pointed the wrong direction, this token cannot write.
SHOPIFY_PROD_STORE=prod-store.myshopify.com
SHOPIFY_PROD_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dev store — read-write custom app token.
SHOPIFY_DEV_STORE=dev-store.myshopify.com
SHOPIFY_DEV_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
